# ---------------------------------------------------------------------------
# Seen — environment
# Copy to .env.local. Every key is optional: without them the app runs in demo
# mode with a seeded local store, a vector corridor map and a simulated MoMo
# checkout, which is how the screenshots in /docs were produced.
# ---------------------------------------------------------------------------

# Paystack (Ghana). Test keys work; amounts are charged in pesewas.
# With no secret key, checkout falls back to /paystack/checkout (demo approval).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Mapbox GL. With no token the app renders its own vector corridor map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase. Apply src/lib/db/schema.sql, then point the app at the project.
# (The local JSON store remains the default until the adapter is selected.)
NEXT_PUBLIC_SUPABASE_URL=https://vppernwgmpfyaxasdldi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signing secrets — generate with: openssl rand -hex 32
SEEN_SESSION_SECRET=
SEEN_MINI_SECRET=
